# ==============================================================================
# AI Campus Companion - Backend Environment Configuration (Example)
# ==============================================================================
# IMPORTANT: Copy this file to '.env' and update values as needed for your setup.
# Never commit real credentials or .env files containing production secrets to git.

# ------------------------------------------------------------------------------
# MongoDB Connection
# ------------------------------------------------------------------------------
# Option A: Local MongoDB (Default standalone / MongoDB Compass)
MONGODB_URI=mongodb://localhost:27017

# Option B: MongoDB Atlas (Cloud Cluster)
# Replace <username>, <password>, and <cluster-url> with your Atlas details:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority

# Name of the MongoDB database for this application
DATABASE_NAME=ai_campus_companion

# ------------------------------------------------------------------------------
# Server & Environment Settings
# ------------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
ENVIRONMENT=development
